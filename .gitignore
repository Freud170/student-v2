# https://git-scm.com/docs/gitignore#_pattern_format
# Angelehnt an das Hono-Beispielprojekt des Profs

# Kompilierte Dateien
dist
build

# Abhaengige Dateien
node_modules
package-lock.json

# Generierte Dateien
extras/doc/html/*
temp
tmp
dependency-check-report.html

# Sensible Daten (Passwort, Token, private Schluessel)
.env
# src/config/tls/key.pem ist bewusst im Repo (selbstsigniert, nur fuer die Entwicklung)
extras/compose/keycloak/tls/key.pem
extras/compose/postgres/password.txt
extras/compose/postgres/init/tls/server.key
sonar-project.properties

# Logs
log
logs
*.log
pnpm-debug.log*

# Tests
coverage

# SonarQube
.scannerwork
.sonar
.sonarlint

# Betriebssystem
.DS_Store
Thumbs.db

# IDEs und Editoren
.idea
*.iml

# VS Code: nur gemeinsame Einstellungen ins Repo
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
