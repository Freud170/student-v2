{
  "name": "student",
  "version": "2026.11.0",
  "private": true,
  "description": "Appserver mit Hono zur Verwaltung von Studierendendaten",
  "type": "module",
  "scripts": {
    "start": "node src/index.mts",
    "dev": "node --watch src/index.mts",
    "hello": "node --watch src/index.mts",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "sonar": "node scripts/sonar-scanner.mts",
    "dependency-check": "node scripts/dependency-check.mts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "c12": "4.0.0-rc.4",
    "hono": "5.0.0-rc.0",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "@tsconfig/node-ts": "23.6.4",
    "@tsconfig/node26": "26.0.1",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "26.6.6",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "typescript": "7.1.0-beta",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.19.0",
      "onFail": "warn"
    },
    "runtime": {
      "name": "node",
      "version": "^26.13.0",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": "^26.13.0",
    "pnpm": "^12.19.0"
  }
}
