{
  "extends": [
    "@tsconfig/strictest/tsconfig",
    "@tsconfig/node26/tsconfig",
    "@tsconfig/node-ts"
  ],
  "include": [
    "src/**/*",
    "test/**/*",
    "scripts/*",
    "*.mts",
    "drizzle.config.ts"
  ],
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "esnext",
    "lib": ["esnext"],
    "types": ["node"],

    "noErrorTruncation": true,
    "outDir": "./dist",
    "rootDir": "."
  }
}
